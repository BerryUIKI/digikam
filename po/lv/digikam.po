#: core/utilities/firstrun/collectionpage.cpp:71
#, kde-format
msgctxt ""
"This is a path name so you should include the slash in the translation"
msgid "/Pictures"
msgstr "/Attēli"

#: core/utilities/firstrun/collectionpage.cpp:77
#, kde-format
msgid ""
"<p>Please enter a location where you keep your images.</p> <p>You can choose "
"any local folder, even one that already contains images.<br> More folders "
"can be added later under the <i>Settings</i> menu. </p> "
msgstr ""
"<p>Norādiet vietu, kurā vēlaties glabāt attēlus.</p> <p>Varat izvēlēties "
"jebkuru lokālu mapi — arī tad, ja tā jau satur attēlus.<br/>Vairāk mapju "
"varat pievienot izvēlnē <i>Iestatījumi</i>.</p> "

#: core/utilities/firstrun/collectionpage.cpp:85
#, kde-format
msgid ""
"<p><i>Note:</i> removable media (such as USB drives or DVDs) and remote file "
"systems (such as NFS, or Samba mounted with cifs/smbfs) are supported.</p>"
msgstr ""
"<p><i>Ievērībai:</t> tiek atbalstīti arī noņemamie datu nesēji (piemēram, "
"USB vai DVD diski) un attālinātas datņu sistēmas (piemēram, NFS vai „Samba“, "
"kas montēta ar „cifs“/„smbfs“).</p><p></p>"

#: core/utilities/firstrun/collectionpage.cpp:148
#, kde-format
msgid ""
"You must select a folder for digiKam to use as the root album. All of your "
"images will go there."
msgstr ""
"Norādiet mapi, ko „digiKam“ izmantot par saknes albumu. Tur tiks saglabāti "
"visi jūsu attēli."

#: core/utilities/firstrun/collectionpage.cpp:176
#, kde-format
msgctxt "@title:window"
msgid "Create Root Album Folder?"
msgstr "Vai izveidot saknes albuma mapi?"

#: core/utilities/firstrun/collectionpage.cpp:177
#, kde-format
msgid ""
"<p>The folder to use as the root album path does not exist:</p><p><b>%1</b></"
"p>Would you like digiKam to create it for you?"
msgstr ""
"<p>Mape, ko izmantot kā albuma saknes mapi, nepastāv:</p><p><b>%1</b></p>Vai "
"vēlaties, lai „digiKam“ to izveido?"

#: core/utilities/firstrun/collectionpage.cpp:189
#, kde-format
msgctxt "@title:window"
msgid "Create Root Album Folder Failed"
msgstr "Albuma saknes mapes izveidošana neizdevās"

#: core/utilities/firstrun/collectionpage.cpp:190
#, kde-format
msgid ""
"<p>digiKam could not create the folder to use as the root album.<br>Please "
"select a different location.</p><p><b>%1</b></p>"
msgstr ""
"<p>„digiKam“ neizdevās izveidot albuma saknes mapi.\n"
"Izvēlieties citu vietu.</p><p><b>%1</b></p>"

#: core/utilities/firstrun/collectionpage.cpp:215
#, kde-format
msgid ""
"You do not seem to have write access for the folder selected to be the root "
"album.\n"
"Warning: Without write access, items cannot be edited."
msgstr ""
"Jums nav rakstīšanas atļauju albuma saknes mapē.\n"
"Brīdinājums: bez rakstīšanas atļaujām nebūs iespējama datņu rediģēšana."

#: core/utilities/firstrun/databasepage.cpp:49
#, kde-format
msgid "<b>Configure where you will store databases</b>"
msgstr "<p>Konfigurēt vietu, kurā glabāt datubāzes</p>"

#: core/utilities/firstrun/metadatapage.cpp:51
#, kde-format
msgid "<b>Configure Metadata Storage to Files</b>"
msgstr "<b>Konfigurē metadatu saglabāšanu datnēs</b>"

#: core/utilities/firstrun/metadatapage.cpp:59
#, kde-format
msgid ""
"<qt><p>Set here if you want to store the information assigned to items in "
"digiKam in the files' metadata, to improve interoperability with other photo "
"management programs:</p></qt>"
msgstr ""
"<qt><p>Norādiet te, vai vēlaties datņu metadatos saglabāt informāciju, kas "
"piešķirta vienumiem „digiKam“, lai uzlabotu sadarbspēju ar citām fotogrāfiju "
"pārvaldības programmām:</p></qt>"

#: core/utilities/firstrun/metadatapage.cpp:69
#, kde-format
msgid "Do nothing"
msgstr "Nedarīt neko"

#: core/utilities/firstrun/metadatapage.cpp:74
#, kde-format
msgid "Add information to files"
msgstr "Pievienot datnēm informāciju"

#: core/utilities/firstrun/metadatapage.cpp:84
#, kde-format
msgid ""
"<qt><p><i>Note:</i> recording information to the files' metadata can slow "
"down photo management operations.</p></qt>"
msgstr ""
"<qt><p><i>Ievērībai:</i> informācijas saglabāšana datņu metadatos var "
"palēnināt darbības ar fotogrāfijām.</p></qt>"

#: core/utilities/firstrun/openfilepage.cpp:53
#, kde-format
msgid "<b>Configure Open File Behavior</b>"
msgstr "<b>Konfigurē datņu atvēršanas uzvedību</b>"

#: core/utilities/firstrun/openfilepage.cpp:61
#, kde-format
msgid ""
"<qt><p>Specify how images should be opened when left-clicked on in the icon "
"view:</p></qt>"
msgstr ""
"<qt><p>Norādiet, kā attēli ir jāatver, veicot peles kreiso klikšķi uz attēla "
"ikonu skatā:</p></qt>"

#: core/utilities/firstrun/openfilepage.cpp:70
#, kde-format
msgid "Open a preview"
msgstr "Atvērt priekšskatījumu"

#: core/utilities/firstrun/openfilepage.cpp:75
#, kde-format
msgid "Open in the editor"
msgstr "Atvērt redaktorā"

#: core/utilities/firstrun/openfilepage.cpp:85
#, kde-format
msgid ""
"<qt><p><i>Note:</i> using a preview is always faster than using the editor, "
"especially when checking a series of shots. However, you cannot change or "
"fix the image in preview mode. Note that if you want to compare images "
"quickly, it is often better to use the light table: images can be displayed "
"side-by-side, and synchronized zooming and panning can be performed.</p></qt>"
msgstr ""
"<qt><p><i>Ievērībai:</i> priekšskatījuma lietošana vienmēr ir ātrāka nekā šī "
"redaktora lietošana — īpaši, ja pārskatāt vairākus fotouzņēmumus. Tomēr "
"priekšskatījuma režīmā attēla rediģēšana un koriģēšana nav iespējama. "
"Ievērojiet, ka, vēlēdamies ātri salīdzināt attēlus, bieži labāk ir izmantot "
"gaismas galdu: attēlu tad var novietot vienu otram blakus, veicot sinhronu "
"tālummaiņu un pagriešanu.</p></qt>"

#: core/utilities/firstrun/previewpage.cpp:52
#, kde-format
msgid "<b>Configure Preview Behavior</b>"
msgstr "<b>Konfigurēt priekšskatījuma uzvedību</b>"

#: core/utilities/firstrun/previewpage.cpp:60
#, kde-format
msgid ""
"<qt><p>Set here how images are displayed in preview mode and on the light "
"table:</p></qt>"
msgstr ""
"<qt><p>Norādiet, kā attēli tiks parādīti priekšskatījuma režīmā un uz "
"gaismas galda:</p></qt>"

#: core/utilities/firstrun/previewpage.cpp:69
#, kde-format
msgid "Load reduced version of image"
msgstr "Ielādēt attēla samazinātu versiju"

#: core/utilities/firstrun/previewpage.cpp:74
#, kde-format
msgid "Load image"
msgstr "Ielādēt pilnu attēlu"

#: core/utilities/firstrun/previewpage.cpp:84
#, kde-format
msgid ""
"<qt><p><i>Note:</i> loading a reduced version of an image is faster but can "
"differ from the original, especially with Raw. In this case, a JPEG version "
"of Raw pre-processed by camera is loaded, instead of the real image data. "
"This JPEG image is embedded in the file metadata and is used by the camera "
"to display a Raw image faster to a TV screen.</p></qt>"
msgstr ""
"<qt><p><i>Ievērībai:</i> samazinātas attēla versijas ielāde notiek ātrāk, "
"bet attēls var nedaudz atšķirties no oriģināla (īpaši no RAW versijas, ja "
"tāda ir). Šajā gadījumā tiek ielādēta RAW kameras iepriekš apstrādāta attēla "
"JPEG versija, bet ne reālie attēla dati. Šis JPEG attēls tiek iegults datnes "
"metadatos, lai to izmantotu kamera un TV ekrānā ātrāk parādītu RAW attēlu.</"
"p></qt>"

#: core/utilities/firstrun/rawpage.cpp:52
#, kde-format
msgid "<b>Configure Raw File Handling</b>"
msgstr "<b>Konfigurē „Raw“ datņu apstrādi</b>"

#: core/utilities/firstrun/rawpage.cpp:60
#, kde-format
msgid "<qt><p>Set here how you want to open Raw images in the editor:</p></qt>"
msgstr "<qt><p>Norādiet, kā vēlaties redaktorā atvērt „Raw“ attēlus:</p></qt>"

#: core/utilities/firstrun/rawpage.cpp:69
#, kde-format
msgid "Open directly, with adjustments made automatically"
msgstr "Atvērt uzreiz, automātiski veicot pārveidošanu"

#: core/utilities/firstrun/rawpage.cpp:74
#, kde-format
msgid "Use the Raw import tool to adjust corrections manually"
msgstr "Lietot „Raw“ importēšanas rīku un pašrocīgi koriģēt attēlu"

#: core/utilities/firstrun/rawpage.cpp:84
#, kde-format
msgid ""
"<qt><p><i>Note:</i> the Raw import tool is designed for advanced users who "
"want to have the best control over the image. This requires more time in "
"your workflow.</p></qt>"
msgstr ""
"<qt><p><i>Ievērībai:</i> RAW importēšanas rīks ir paredzēts zinošiem "
"lietotājiem, kuri vēlas augstāko kontroli pār fotogrāfiju. Šāda attēlu "
"apstrāde prasīs lielāku cilvēka iesaisti un laiku.</p></qt>"

#: core/utilities/firstrun/startscanpage.cpp:34
#, kde-format
msgid "Scan Your Collection"
msgstr "Skenēt kolekciju"

#: core/utilities/firstrun/startscanpage.cpp:40
#, kde-format
msgid ""
"<qt><p>Congratulations. Your minimal setup is done.</p><p>Remember, you can "
"customize more settings using the digiKam configuration panel. To learn more "
"about the digiKam world, we recommend reading the <b>digiKam handbook</b> "
"using the <b>Help/Handbook</b> menu entry (you need to install the separate "
"digiKam documentation package.) You can also read the manual online from the "
"<a href='https://docs.digikam.org/en/index.html'>dedicated website</a>.</"
"p><p>Press <b>Finish</b> to close this assistant. digiKam will scan your "
"collection to register all albums in the database. Items including in albums "
"are collected after startup stage in background.</p><p><i>Note:</i> "
"depending on your collection size, this operation can take a while. If you "
"cancel the scanning operation, it will start again in the next digiKam "
"session.</p><p>When scanning has completed, at next start-up, digiKam will "
"only check your collection to identify new albums - which is much faster. "
"You can force digiKam to scan for new items manually using the <b>Tools-"
">Maintenance->Scan for new items</b> menu entry.</p></qt>"
msgstr ""
"<qt><p>Apsveicam! Minimālā sagatavošanās darbam ir pabeigta.</p><p>Atceries, "
"ka vari pielāgot papildu iestatījumus, lietojot „digiKam“ konfigurācijas "
"paneli. Lai uzzinātu vairāk par „digiKam“ pasauli, iesakām izlasīt "
"<b>„digiKam“ rokasgrāmatu</b>, ko varat atrast <b>Palīdzība/Rokasgrāmata</b> "
"izvēlnē (būs nepieciešams ieinstalēt atsevišķu digiKam dokumentācijas "
"pakotni). Tāpat varat arī izlasīt rokasgrāmatu tiešsaistē <a href='https://"
"docs.digikam.org/en/index.html'>tīmekļa vietnē (angļu val.)</a>.</p><p>Lai "
"aizvērtu šo asistentu, spiediet uz <b>Pabeigt</b>. „digiKam“ pārskenēs "
"kolekciju, lai datubāzē reģistrētu visus albumus. Albumos iekļautie vienumi "
"tiek iegūti fonā pēc palaišanas stadijas.</p><p><i>Ievērībai:</i> šī darbība "
"aizņem vairāk vai mazāk laika atkarībā no kolekcijas izmēra. Ja atcelsit "
"skenēšanu, tā tiks uzsākta no jauna nākamajā „digiKam“ sesijā.</p><p>Pēc "
"skenēšanas pabeigšanas, nākamajā palaišanas reizē, „digiKam“ pārbaudīs "
"kolekciju tikai tik daudz, lai atrastu jaunus albumus, kas būs daudz ātrāk. "
"Jūs varat piespiest „digiKam“ manuāli meklēt jaunus vienumus, lietojot "
"<b>Rīki->Apkope->Skenēt jaunus vienumus</b> izvēlnes iespēju.</p></qt>"

#: core/utilities/firstrun/tooltipspage.cpp:52
#, kde-format
msgid "<b>Enabled Contextual Tooltips</b>"
msgstr "<b>Ieslēgt kontekstuālās paskaidres</b>"

#: core/utilities/firstrun/tooltipspage.cpp:60
#, kde-format
msgid ""
"<qt><p>Set here if you want to show contextual tooltips in icon-view and "
"folder-view:</p></qt>"
msgstr ""
"<qt><p>Norādiet, vai vēlaties ikonu un mapju skatā redzēt kontekstuālās "
"paskaidres:</p></qt>"

#: core/utilities/firstrun/tooltipspage.cpp:69
#, kde-format
msgid "Do not show tooltips"
msgstr "Nerādīt paskaidres"

#: core/utilities/firstrun/tooltipspage.cpp:74
#, kde-format
msgid "Use Tooltips"
msgstr "Rādīt paskaidres"

#: core/utilities/firstrun/tooltipspage.cpp:84
#, kde-format
msgid ""
"<qt><p><i>Note:</i> tooltips show photograph and digiKam metadata on the "
"fly, as the mouse moves over items. This can be useful when selecting items. "
"Tooltips are displayed in the album folder view, album icon view, camera "
"icon view, batch queue list, and thumb bar. From the digiKam configuration "
"dialog, you can customize the contents of these tooltips and the fonts used."
"</p></qt>"
msgstr ""
"<qt><p><i>Ievērībai:</i> paskaidre parāda fotogrāfijas un „digiKam“ "
"metadatus, pārvelkot peles rādītāju pāri vienumam. Tas var būt noderīgi, "
"atlasot vienumus. Paskaidres tiek parādīts albuma mapju skatā, albuma ikonu "
"skatā, kameras ikonu skatā, masveida rindas skatā un sīktēlu joslā. "
"„digiKam“ konfigurācijas lodziņš ļauj pielāgot šo paskaidrņu saturu un tajos "
"lietotos fontus.</p></qt>"

#: core/utilities/firstrun/welcomepage.cpp:40
#, kde-format
msgid ""
"<qt><p><h1><b>Welcome to digiKam %1</b></h1></p><p>digiKam is an advanced "
"digital photo management application published as open-source.</p><p>This "
"assistant will help you to configure first run settings to be able to use "
"digiKam quickly.</p></qt>"
msgstr ""
"<qt><p><h1><b>Laipni lūgti „digiKam“ %1</b></h1></p><p>„digiKam“ ir jaudīga "
"atvērtā koda digitālo fotogrāfiju pārvaldības programma.</p><p>Šis asistents "
"palīdzēs konfigurēt sākuma iestatījumus, lai varat ātri sākt lietot "
"„digiKam“.</p></qt>"

#: core/utilities/firstrun/welcomepage.cpp:66
#, kde-format
msgid ""
"<qt><br><p>You can ignore the following if you use digiKam for the first "
"time:</p><p><b>Transition from digiKam 4</b></p><p>Configuration files from "
"digiKam 4 are not migrated. The old database can still be used, you just "
"need to choose the same locations for collections and database in the "
"following dialogs. It is recommended to create a backup of your database "
"before proceeding.</p><p>The new location for configuration files is %1 (old "
"%2). There are unresolved problems reported when reusing old configuration "
"files, so it is not recommended to do it for the moment, and therefore use "
"at your own risk.</p></qt>"
msgstr ""
"<qt><br><p>Ja lietojat „digiKam“ pirmo reizi, tālāko varat ignorēt:</"
"p><p><b>Pāriešana no „digiKam 4“</b></p><p>Konfigurācijas datnes no „digiKam "
"4“ netiek migrētas. Veco datubāzi varat turpināt lietot, turpmākajos "
"lodziņos izvēloties identiskas kolekciju un datubāžu atrašanās vietas. Pirms "
"turpināšanas ieteicams izveidot datubāzes rezerves kopiju.</p><p>Jaunā "
"konfigurācijas datņu atrašanās vieta ir „%1“ (vecā bija „%2“). No jauna "
"izmantojot vecākas konfigurācijas datnes, varat saskarties ar izstrādātāju "
"vēl neatrisinātām ziņotām problēmām, tāpēc to darīt šobrīd nav ieteicams un "
"šāda rīcība notiek uz jūsu riska.</p></qt>"

