#: core/libs/rawengine/drawdecoderwidget.cpp:179
#, kde-format
msgctxt "@option:check"
msgid "16 bits color depth"
msgstr "16 bitu krāsu dziļums"

#: core/libs/rawengine/drawdecoderwidget.cpp:180
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>If enabled, all RAW files will be decoded in 16-bit color depth using "
"a linear gamma curve. To prevent dark picture rendering in the editor, it is "
"recommended to use Color Management in this mode.</para><para>If disabled, "
"all RAW files will be decoded in 8-bit color depth with a BT.709 gamma curve "
"and a 99th-percentile white point. This mode is faster than 16-bit decoding."
"</para>"
msgstr ""
"<para>Ja ieslēgts, visas RAW datnes tiks atkodētas 16 bitu krāsu dziļumā, "
"lietojot lineāru gammas līkni. Lai novērstu melnu attēlu atveidošanu "
"redaktorā, ieteicams šajā režīmā lietot krāsu pārvaldību.</para><para>Ja "
"izslēgts, visas RAW datnes tiks atkodētas 8 bitu krāsu dziļumā ar BT.709 "
"gammas līkni un 99 procentu balto punktu. Šis režīms ir ātrāks par 16 bitu "
"atkodēšanu.</para>"

#: core/libs/rawengine/drawdecoderwidget.cpp:199
#, kde-format
msgctxt "@option:check"
msgid "Interpolate RGB as four colors"
msgstr "Interpolēt RGB kā četras krāsas"

#: core/libs/rawengine/drawdecoderwidget.cpp:200
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<title>Interpolate RGB as four colors</title><para>The default is to assume "
"that all green pixels are the same. If even-row green pixels are more "
"sensitive to ultraviolet light than odd-row this difference causes a mesh "
"pattern in the output; using this option solves this problem with minimal "
"loss of detail.</para><para>To resume, this option blurs the image a little, "
"but it eliminates false 2x2 mesh patterns with VNG quality method or mazes "
"with AHD quality method.</para>"
msgstr ""
"<title>RGP interpolēt kā četras krāsas</title><para>Noklusējums ir pieņemt, "
"ka visi zaļie pikseļi ir vienādi. Ja pāra rindu zaļie pikseļi ir jutīgāki "
"pret ultravioleto gaismu nekā nepāra rindās, tad šī starpība izvadē rada "
"tīkla veida izvadi. Šī opcijas atrisina šo problēmu ar minimālu "
"detalizētības zudumu.</para><para>Tātad šī opcija attēlu nedaudz aizmiglos, "
"tomēr novērsīs viltus 2×2 tīkla zīmējumu ar VNG kvalitātes metodi vai "
"labirintus ar AHD kvalitātes metodi.</para>"

#: core/libs/rawengine/drawdecoderwidget.cpp:214
#, kde-format
msgctxt "@info:tooltip"
msgid "Visit LibRaw project website"
msgstr "Apmeklējiet „LibRaw“ projekta tīmekļa vietni"

#: core/libs/rawengine/drawdecoderwidget.cpp:224
#, kde-format
msgctxt "@option:check"
msgid "Do not stretch or rotate pixels"
msgstr "Nestiept un nepagriezt pikseļus"

#: core/libs/rawengine/drawdecoderwidget.cpp:226
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<title>Do not stretch or rotate pixels</title><para>For Fuji Super CCD "
"cameras, show the image tilted 45 degrees. For cameras with non-square "
"pixels, do not stretch the image to its correct aspect ratio. In any case, "
"this option guarantees that each output pixel corresponds to one RAW pixel.</"
"para>"
msgstr ""
"<title>Nestiept un negriezt pikseļus</title><para>„Fuji Super CCD“ "
"fotoaparātiem rādīt attēlu savērstu par 45 grādiem. Fotoaparātiem, kuri "
"izmanto ne kvadrātiskus pikseļus, nestiept attēlu uz to pareizo malu "
"attiecību. Jebkurā gadījumā šī opcijas nodrošina, ka katrs izvades pikselis "
"atbilst vienam RAW datnes pikselim.</para>"

