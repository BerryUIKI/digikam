#: core/libs/dnnmodelmanager/dnnmodelmanager.cpp:378
#, kde-format
msgid "YOLOv11 Nano"
msgstr "YOLOv11 Nano"

#: core/libs/dnnmodelmanager/dnnmodelmanager.cpp:380
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p><b>YOLOv11 Nano</b>: small, lightweight neural network offering "
"exceptional speed, but may miss identifying more objects in images. YOLO can "
"detect multiple objects in an image. It is trained to recognize 80 different "
"objects using the COCO dataset.</p>"
msgstr ""
"<p><b>YOLOv11 Nano</b>: mazs un viegls neirālais tīkls, kas darbojas ļoti "
"ātri, bet var nepareizi identificēt attēlos redzamos objektus. YOLO prot "
"attēlā atpazīt vairākus objektus. Tas ir apmācīts atpazīt 80 dažādus "
"objektus, lietojot COCO datu kopu.</p>"

#: core/libs/dnnmodelmanager/dnnmodelmanager.cpp:385
#, kde-format
msgid "YOLOv11 XLarge"
msgstr "YOLOv11 XLarge"

#: core/libs/dnnmodelmanager/dnnmodelmanager.cpp:387
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p><b>YOLOv11 XLarge</b>: large, robust neural network offering good "
"accuracy. It will detect more objects in images than YOLOv11 Nano, but is "
"slower. YOLO can detect multiple objects in an image. It is trained to "
"recognize 80 different objects using the COCO dataset.</p>"
msgstr ""
"<p><b>YOLOv11 XLarge</b>: liels un uzticams neirālais tīkls, kas sniedz "
"samērā augstu precizitāti. Tas atpazīs vairāk objektu attēlos nekā „YOLOv11 "
"Nano“, tomēr ir lēnāks. YOLO prot attēlā atpazīt vairākus objektus. Tas ir "
"apmācīts atpazīt 80 dažādus objektus, lietojot COCO datu kopu.</p>"

#: core/libs/dnnmodelmanager/dnnmodelmanager.cpp:392
#, kde-format
msgid "EfficientNet B7"
msgstr "EfficientNet B7"

#: core/libs/dnnmodelmanager/dnnmodelmanager.cpp:394
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p><b>EfficientNet B7</b>: large and powerful convoluted neural network. It "
"will detect a single object in an image with high accuracy. EfficientNet B7 "
"was trained to recognize 1,000 different objects using the ImageNet dataset."
"</p>"
msgstr ""
"<p><b>EfficientNet B7</b>: liels un jaudīgs apvienots neirālais tīkls. Tas "
"atpazīst atsevišķu objektu attēlā ar augstu precizitāti. „EfficientNet B7“ "
"ir apmācīts, lai atpazītu 1000 dažādu objektu, lietojot „ImageNet“ datu kopu."
"</p>"

