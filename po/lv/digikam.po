#: core/utilities/setup/editor/setupversioning.cpp:255
#, kde-format
msgctxt "@option:check"
msgid "After converting from a RAW image"
msgstr "Pēc konvertēšanas no RAW attēla"

#: core/utilities/setup/editor/setupversioning.cpp:256
#, kde-format
msgctxt "@option:check"
msgid "After each editing session"
msgstr "Pēc katras rediģēšanas sesijas"

#: core/utilities/setup/editor/setupversioning.cpp:257
#, kde-format
msgctxt "@option:check"
msgid "After each step that is not completely reproducible"
msgstr "Pēc katra soļa, kas nav pilnībā reproducējams"

#: core/utilities/setup/editor/setupversioning.cpp:284
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>If an image has been edited, only the <interface>current versions</"
"interface> will be shown in the main thumbnail view. From the "
"<interface>right sidebar</interface>, you always have access to all hidden "
"files.</para> <para>With the options here, you can choose to show certain "
"files permanently.</para> <para>If you activate non-destructive editing and "
"image versioning for the first time, it will only be work for newly saved "
"images.</para>"
msgstr ""
"<para>Ja attēls ir rediģēts pamata sīktēlu skatā tiks parādītas tikai "
"<interface>pašreizējās versijas</interface>. <interface>Labā sānjosla</"
"interface> vienmēr piedāvā iespēju piekļūt visām paslēptajām datnēm.</para> "
"<para>Te esošās opcijas ļauj izvēlēties noteiktas datnes rādīt pastāvīgi.</"
"para> <para>Pirmo reizi ieslēdzot nedestruktīvo rediģēšanu un attēlu versiju "
"kontroli, tā būs spēkā tikai no jauna saglabātajiem attēliem.</para>"

#: core/utilities/setup/editor/setupversioning.cpp:292
#, kde-format
msgctxt "@label"
msgid "In main view"
msgstr "Pamata skatā"

#: core/utilities/setup/editor/setupversioning.cpp:301
#, kde-format
